---
import '../styles/global.css';
import '../styles/islands.css';
import Sidebar from '../components/Sidebar.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  current?: string;
  wide?: boolean;
}

const { title, description = 'An interactive system design course for frontend developers.', current, wide = false } = Astro.props;
const fullTitle = title === 'System Design Course' ? title : `${title} · System Design Course`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={url('icons/apple-touch-icon.png')} />
    <meta name="theme-color" content="#6366f1" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="SysDesign" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="topbar">
      <button class="icon-btn menu-btn" aria-label="Toggle menu" id="menu-btn">☰</button>
      <a href={url('/')} class="brand">
        <span class="logo">
          <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true"
            ><rect width="32" height="32" rx="8" fill="currentColor"></rect><circle cx="9" cy="16" r="3.5" fill="#fff"
            ></circle><circle cx="23" cy="9" r="3.5" fill="#fff"></circle><circle cx="23" cy="23" r="3.5" fill="#fff"
            ></circle><path d="M12 15l8-5M12 17l8 5" stroke="#fff" stroke-width="2"></path></svg
          >
        </span>
        <span class="brand-text">System Design <span class="muted">Course</span></span>
      </a>
      <nav class="top-links">
        <a href={url('glossary')}>Glossary</a>
        <a href={url('flashcards')}>Flashcards</a>
        <a href={url('practice')}>Practice</a>
        <a href={url('final-exam')}>Final Exam</a>
      </nav>
      <div class="top-actions">
        <button class="offline-chip" id="offline-chip" hidden aria-live="polite"></button>
      <button class="install-btn" id="install-btn" hidden>📲 <span>Install app</span></button>
      <button class="icon-btn" id="theme-btn" aria-label="Toggle dark mode" title="Toggle theme"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"></path></svg></button>
      </div>
    </header>

    <div class="ios-tip" id="ios-tip" hidden role="dialog" aria-label="Install on iPhone">
      <button class="ios-close" id="ios-close" aria-label="Close">✕</button>
      <b>Install on iPhone / iPad</b>
      <ol>
        <li>Open this page in <b>Safari</b></li>
        <li>Tap the <b>Share</b> button <span class="ios-ico">⬆️</span></li>
        <li>Choose <b>Add to Home Screen</b></li>
      </ol>
    </div>

    <div class="shell">
      <aside class="sidebar" id="sidebar">
        <Sidebar current={current} />
      </aside>
      <div class="scrim" id="scrim"></div>
      <main class:list={['main', { wide }]}>
        <slot />
      </main>
    </div>

    <script is:inline define:vars={{ swUrl: url('sw.js'), scope: url('/') }}>
      if ('serviceWorker' in navigator && location.protocol !== 'file:') {
        const chip = document.getElementById('offline-chip');
        const render = (m) => {
          if (!chip) return;
          chip.hidden = false;
          chip.className = 'offline-chip';
          if (m.complete) {
            chip.classList.add('ok');
            chip.textContent = '✓ Offline ready';
            chip.title = 'All ' + m.total + ' files are saved on this device. The whole course works without internet.';
          } else if (m.running) {
            chip.classList.add('busy');
            chip.textContent = '⬇ Saving offline ' + Math.round((m.done / m.total) * 100) + '%';
            chip.title = 'Downloading the course for offline use (' + m.done + '/' + m.total + '). Keep the app open.';
          } else {
            chip.classList.add('warn');
            chip.textContent = '⚠ Tap to finish offline download';
            chip.title = m.done + '/' + m.total + ' files saved. Some downloads failed; tap to retry.';
          }
        };
        const ask = async () => {
          try {
            const reg = await navigator.serviceWorker.ready;
            (reg.active || navigator.serviceWorker.controller)?.postMessage({ type: 'precache' });
          } catch {}
        };
        navigator.serviceWorker.addEventListener('message', (e) => {
          if (e.data && e.data.type === 'precache-status') render(e.data);
        });
        chip?.addEventListener('click', ask);
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(swUrl, { scope }).then(ask).catch(() => {});
        });
        // a new service worker took over: ask it to finish downloading
        navigator.serviceWorker.addEventListener('controllerchange', ask);
      }
    </script>
    <script>
      const root = document.documentElement;
      document.getElementById('theme-btn')?.addEventListener('click', () => {
        const isDark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        const next = isDark ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
      // ----- install as an app -----
      const installBtn = document.getElementById('install-btn') as HTMLButtonElement | null;
      const iosTip = document.getElementById('ios-tip');
      const standalone =
        window.matchMedia('(display-mode: standalone)').matches || (navigator as unknown as { standalone?: boolean }).standalone === true;
      const ua = navigator.userAgent;
      const isIos = /iphone|ipad|ipod/i.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
      let deferred: (Event & { prompt: () => Promise<void>; userChoice: Promise<{ outcome: string }> }) | null = null;
      if (!standalone && installBtn) {
        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault();
          deferred = e as typeof deferred;
          installBtn.hidden = false;
        });
        if (isIos) installBtn.hidden = false;
        installBtn.addEventListener('click', async () => {
          if (deferred) {
            await deferred.prompt();
            await deferred.userChoice;
            deferred = null;
            installBtn.hidden = true;
          } else if (iosTip) {
            iosTip.hidden = !iosTip.hidden;
          }
        });
        window.addEventListener('appinstalled', () => {
          installBtn.hidden = true;
        });
      }
      document.getElementById('ios-close')?.addEventListener('click', () => {
        if (iosTip) iosTip.hidden = true;
      });

      const sidebar = document.getElementById('sidebar');
      const scrim = document.getElementById('scrim');
      const toggle = () => {
        sidebar?.classList.toggle('open');
        scrim?.classList.toggle('open');
      };
      document.getElementById('menu-btn')?.addEventListener('click', toggle);
      scrim?.addEventListener('click', toggle);
    </script>

    <style>
      .topbar {
        position: sticky;
        top: 0;
        z-index: 40;
        height: 60px;
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 0 1rem;
        background: color-mix(in srgb, var(--bg) 85%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border);
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        text-decoration: none;
        color: var(--text);
        font-weight: 750;
        letter-spacing: -0.01em;
      }
      .logo {
        color: var(--accent);
        display: flex;
      }
      .top-links {
        margin-left: auto;
        display: flex;
        gap: 1.2rem;
        font-size: 0.9rem;
      }
      .top-links a {
        color: var(--text-soft);
        text-decoration: none;
        font-weight: 550;
      }
      .top-links a:hover {
        color: var(--accent-text);
      }
      .icon-btn {
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
        border-radius: 9px;
        width: 36px;
        height: 36px;
        cursor: pointer;
        font-size: 1.05rem;
        flex-shrink: 0;
        display: grid;
        place-items: center;
      }
      .menu-btn {
        display: none;
      }
      .install-btn {
        border: 1px solid var(--accent);
        background: var(--accent-soft);
        color: var(--accent-text);
        border-radius: 9px;
        height: 36px;
        padding: 0 0.8rem;
        font-weight: 650;
        font-size: 0.85rem;
        cursor: pointer;
        white-space: nowrap;
      }
      .offline-chip {
        border: 1px solid var(--border-strong);
        background: var(--surface);
        color: var(--text-soft);
        border-radius: 999px;
        height: 30px;
        padding: 0 0.75rem;
        font-size: 0.78rem;
        font-weight: 650;
        cursor: pointer;
        white-space: nowrap;
      }
      .top-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-left: 0.4rem;
        flex-shrink: 0;
      }
      .offline-chip[hidden] {
        display: none;
      }
      .offline-chip.ok {
        border-color: var(--good);
        background: var(--good-soft);
        color: var(--good);
      }
      .offline-chip.busy {
        border-color: var(--info);
        background: var(--info-soft);
        color: var(--info);
      }
      .offline-chip.warn {
        border-color: var(--warn);
        background: var(--warn-soft);
        color: var(--warn);
      }
      .install-btn[hidden] {
        display: none;
      }
      .ios-tip {
        position: fixed;
        top: 68px;
        right: 12px;
        z-index: 60;
        width: min(320px, calc(100vw - 24px));
        background: var(--surface);
        border: 1px solid var(--border-strong);
        border-radius: 14px;
        padding: 0.9rem 1rem;
        box-shadow: var(--shadow);
        font-size: 0.92rem;
      }
      .ios-tip[hidden] {
        display: none;
      }
      .ios-tip ol {
        margin: 0.4rem 0 0;
        padding-left: 1.2rem;
      }
      .ios-close {
        float: right;
        border: none;
        background: none;
        color: var(--text-faint);
        cursor: pointer;
      }
      .shell {
        display: flex;
        min-height: calc(100vh - 60px);
      }
      .sidebar {
        width: 300px;
        flex-shrink: 0;
        position: sticky;
        top: 60px;
        height: calc(100vh - 60px);
        overflow-y: auto;
        border-right: 1px solid var(--border);
        background: var(--bg-soft);
      }
      .main {
        flex: 1;
        min-width: 0;
        overflow-x: clip;
        padding: 2rem 2.2rem 5rem;
      }
      .scrim {
        display: none;
      }
      @media (max-width: 960px) {
        .menu-btn {
          display: block;
        }
        .top-links {
          display: none;
        }
        .top-actions {
          margin-left: auto;
        }
        .sidebar {
          position: fixed;
          left: 0;
          top: 60px;
          z-index: 50;
          transform: translateX(-100%);
          transition: transform 0.2s ease;
          box-shadow: var(--shadow);
        }
        .sidebar.open {
          transform: none;
        }
        .scrim.open {
          display: block;
          position: fixed;
          inset: 60px 0 0 0;
          background: rgba(0, 0, 0, 0.35);
          z-index: 45;
        }
        .main {
          padding: 1.4rem 16px 4rem;
        }
      }
      @media (max-width: 420px) {
        .brand-text .muted {
          display: none;
        }
      }
    </style>
  </body>
</html>
