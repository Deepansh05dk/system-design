---
import Base from '../layouts/Base.astro';
import DesignCanvas from '../components/islands/DesignCanvas';
---

<Base title="Design Canvas" description="Practice building architectures for classic prompts and get instant feedback." current="practice" wide>
  <div class="page">
    <div class="kicker">🧩 Practice</div>
    <h1>Design Canvas</h1>
    <p class="lede">
      Pick a prompt, read the requirements, and build an architecture from the component palette. Then check it: you’ll
      see which essentials you missed, which additions are smart, and where you over-engineered. Your picks are saved in
      this browser.
    </p>
    <DesignCanvas client:load base={import.meta.env.BASE_URL} />
    <div class="tip card">
      <b>How to practice like an interview:</b> before clicking anything, say the requirements and estimation out loud.
      For every component you add, say one sentence: <i>“I add X because Y.”</i> If you can’t finish that sentence, leave
      it out.
    </div>
  </div>
</Base>

<style>
  .page {
    max-width: 1100px;
    margin: 0 auto;
  }
  .kicker {
    font-weight: 800;
    color: var(--accent-text);
    font-size: 0.85rem;
  }
  h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin: 0.3rem 0;
    letter-spacing: -0.02em;
  }
  .lede {
    color: var(--text-soft);
    font-size: 1.05rem;
    max-width: 760px;
  }
  .tip {
    margin-top: 1.5rem;
    padding: 1rem 1.2rem;
    font-size: 0.95rem;
  }
</style>
