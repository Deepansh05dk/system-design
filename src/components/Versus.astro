---
interface Option {
  name: string;
  icon?: string;
  pros?: string[];
  cons?: string[];
  use?: string;
}
interface Props {
  items: Option[];
  title?: string;
}
const { items, title } = Astro.props;
---

<div class="versus-wrap">
  {title && <div class="vs-title">{title}</div>}
  <div class="versus" style={`--n:${items.length}`}>
    {
      items.map((o, i) => (
        <>
          <div class="opt">
            <div class="opt-name">
              {o.icon && <span class="opt-icon">{o.icon}</span>}
              {o.name}
            </div>
            {o.pros && (
              <ul class="pros">
                {o.pros.map((p) => (
                  <li set:html={p} />
                ))}
              </ul>
            )}
            {o.cons && (
              <ul class="cons">
                {o.cons.map((p) => (
                  <li set:html={p} />
                ))}
              </ul>
            )}
            {o.use && (
              <div class="use">
                <strong>Use when:</strong> <span set:html={o.use} />
              </div>
            )}
          </div>
          {i < items.length - 1 && items.length === 2 && <div class="vs">VS</div>}
        </>
      ))
    }
  </div>
</div>

<style>
  .versus-wrap {
    margin: 1.6rem 0;
  }
  .vs-title {
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .versus {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.8rem;
    align-items: stretch;
  }
  .versus:has(.vs) {
    grid-template-columns: 1fr auto 1fr;
  }
  .opt {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    box-shadow: var(--shadow);
    font-size: 0.92rem;
  }
  .opt-name {
    font-weight: 750;
    font-size: 1.02rem;
    display: flex;
    gap: 0.45rem;
    align-items: center;
    margin-bottom: 0.4rem;
  }
  .opt-icon {
    font-size: 1.2rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0.3rem 0;
  }
  li {
    padding-left: 1.4rem;
    position: relative;
    margin: 0.25rem 0;
    line-height: 1.5;
  }
  .pros li::before {
    content: '✓';
    position: absolute;
    left: 0.1rem;
    color: var(--good);
    font-weight: 800;
  }
  .cons li::before {
    content: '✗';
    position: absolute;
    left: 0.1rem;
    color: var(--bad);
    font-weight: 800;
  }
  .use {
    margin-top: 0.6rem;
    padding-top: 0.55rem;
    border-top: 1px dashed var(--border);
    font-size: 0.88rem;
    color: var(--text-soft);
  }
  .vs {
    align-self: center;
    font-weight: 900;
    font-size: 0.85rem;
    color: var(--text-faint);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 50%;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
  }
  @media (max-width: 640px) {
    .versus:has(.vs) {
      grid-template-columns: 1fr;
    }
    .vs {
      justify-self: center;
    }
  }
</style>
