---
import { glossary } from '../data/glossary';
import { url } from '../lib/url';
interface Props {
  k: string;
}
const { k } = Astro.props;
const entry = glossary[k];
if (!entry) throw new Error(`Unknown glossary term: ${k}`);
---

<span class="term" tabindex="0"
  ><slot>{entry.term}</slot><span class="tip" role="tooltip"
    ><strong>{entry.term}</strong>{entry.short}<a href={url(`glossary#${k}`)}>Glossary →</a></span
  ></span
>

<style>
  .term {
    position: relative;
    border-bottom: 1.5px dotted var(--accent);
    cursor: help;
  }
  .tip {
    visibility: hidden;
    opacity: 0;
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    transform: translateX(-50%) translateY(4px);
    width: min(280px, 80vw);
    background: var(--text);
    color: var(--bg);
    font-size: 0.82rem;
    line-height: 1.5;
    padding: 0.6rem 0.75rem;
    border-radius: 10px;
    z-index: 30;
    transition: opacity 0.15s, transform 0.15s;
    box-shadow: var(--shadow);
    font-weight: 400;
  }
  .tip strong {
    display: block;
    margin-bottom: 0.15rem;
  }
  .tip a {
    display: block;
    margin-top: 0.3rem;
    color: inherit;
    opacity: 0.7;
    font-size: 0.75rem;
  }
  .term:hover .tip,
  .term:focus .tip,
  .term:focus-within .tip {
    visibility: visible;
    opacity: 1;
    transform: translateX(-50%);
  }
</style>
